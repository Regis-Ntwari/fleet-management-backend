# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=limoz_fleet
DB_USERNAME=limoz
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# ---- Application ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
FLEET_TIMEZONE=Africa/Kigali
FLEET_CURRENCY=RWF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Security (generate with: openssl rand -base64 48) ----
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D

# ---- Bootstrap administrator (created on first start if no users exist) ----
ADMIN_EMAIL=admin@limoz.rw
ADMIN_PASSWORD=

# ---- Development seed data (realistic fleet dataset, dev profile only) ----
SEED_DATA=true

# ---- File storage ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
MAX_UPLOAD_SIZE=15MB

# ---- Telematics (none | wialon ...) ----
TELEMATICS_PROVIDER=none

# ---- Swagger in production ----
SWAGGER_ENABLED=false
